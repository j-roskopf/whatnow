# Server-side API keys (Vercel project settings → Environment Variables).
# Optional locally: copy to .env for `npm run generate-data`.
STEAMGRIDDB_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
OPENCRITIC_KEY=

# Shared Redis cache for /api/meta (Vercel → Marketplace → Upstash Redis).
# Auto-populated when you connect the integration; also works with legacy KV_* names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
